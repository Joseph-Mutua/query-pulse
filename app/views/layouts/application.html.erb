<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "QueryPulse" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body">
    <aside class="sidebar">
      <%= link_to root_path, class: "brand" do %>
        <span class="brand-mark">Q</span><span>QueryPulse</span>
      <% end %>
      <nav class="nav-list" aria-label="Primary navigation">
        <%= link_to dashboard_path, class: "nav-item #{'active' if controller_name == 'dashboard'}" do %><span>⌁</span> Overview<% end %>
        <%= link_to monitors_path, class: "nav-item #{'active' if controller_name == 'monitors'}" do %><span>◎</span> Monitors<% end %>
        <%= link_to incidents_path, class: "nav-item #{'active' if controller_name == 'incidents'}" do %><span>△</span> Incidents<% end %>
        <%= link_to playground_path, class: "nav-item #{'active' if controller_name == 'playground'}" do %><span>⌘</span> Playground<% end %>
        <%= link_to docs_path, class: "nav-item #{'active' if controller_name == 'docs'}" do %><span>□</span> API docs<% end %>
      </nav>
      <div class="sidebar-foot"><span class="pulse-dot"></span><span>Monitoring ready</span></div>
    </aside>
    <div class="app-shell">
      <header class="topbar">
        <div>
          <p class="eyebrow"><%= content_for(:eyebrow) || "Search reliability operations" %></p>
          <h1><%= content_for(:page_title) || "QueryPulse" %></h1>
        </div>
        <div class="topbar-actions"><%= yield :actions %></div>
      </header>
      <% flash.each do |type, message| %><div class="flash <%= type %>" role="status"><%= message %></div><% end %>
      <main class="content"><%= yield %></main>
    </div>
  </body>
</html>
