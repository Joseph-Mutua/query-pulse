<% content_for :page_title, @incident.title %><% content_for :eyebrow, "#{@incident.incident_type} · #{@incident.monitor.name}" %>
<% content_for :actions do %><% unless @incident.status == "acknowledged" %><%= button_to "Acknowledge", acknowledge_incident_path(@incident), method: :patch, class: "btn", form: { style: "display:inline" } %><% end %><% unless @incident.status == "resolved" %><%= button_to "Resolve", resolve_incident_path(@incident), method: :patch, class: "btn btn-primary", form: { style: "display:inline" } %><% end %><% end %>
<dl class="definition-grid">
  <div class="definition"><dt>Severity</dt><dd><%= status_badge(@incident.severity) %></dd></div><div class="definition"><dt>Status</dt><dd><%= status_badge(@incident.status) %></dd></div>
  <div class="definition"><dt>First seen</dt><dd><%= l(@incident.first_seen_at, format: :short) %></dd></div><div class="definition"><dt>Last seen</dt><dd><%= l(@incident.last_seen_at, format: :short) %></dd></div>
  <div class="definition"><dt>Occurrences</dt><dd class="mono"><%= @incident.occurrence_count %></dd></div><div class="definition"><dt>JSON path</dt><dd class="mono"><%= @incident.path %></dd></div>
  <div class="definition"><dt>Monitor</dt><dd><%= link_to @incident.monitor.name, monitor_path(@incident.monitor), class: "text-signal" %></dd></div><div class="definition"><dt>Query</dt><dd class="mono"><%= @incident.monitor.query %></dd></div>
</dl>
<div class="grid-2" style="margin-top:18px">
  <div><section class="panel"><header class="panel-header"><h2>Observed change</h2></header><div class="panel-body"><p class="text-muted"><%= @incident.description %></p><div class="change-row" style="grid-template-columns:1fr 1fr"><div><span class="secondary">Previous</span><div class="value-box mono"><%= JSON.pretty_generate(@incident.previous_value) rescue @incident.previous_value.inspect %></div></div><div><span class="secondary">Current</span><div class="value-box mono"><%= JSON.pretty_generate(@incident.current_value) rescue @incident.current_value.inspect %></div></div></div></div></section></div>
  <div><section class="panel"><header class="panel-header"><h2>Related executions</h2></header><% @related_runs.each do |run| %><%= link_to run_path(run), class: "incident-card" do %><div class="incident-head"><span class="incident-title mono"><%= short_hash(run.id.to_s) %></span><%= status_badge(run.status) %></div><div class="incident-meta"><%= run.started_at ? l(run.started_at, format: :short) : "Queued" %> · <%= format_duration(run.response_time_ms) %></div><% end %><% end %></section></div>
</div>
